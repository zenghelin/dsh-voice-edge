{
  "name": "dsh-voice-edge",
  "version": "0.0.4",
  "description": "给 DSH 里的 AI 伙伴一副嗓子：想说什么，就合成成语音直接发到 QQ（Node，无 Python）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "tools", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "dependencies": { "msedge-tts": "^2.1.1" },
  "optionalDependencies": { "sherpa-onnx-node": "^2.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  },
  "author": { "name": "zenghelin", "email": "52985131+zenghelin@users.noreply.github.com" },
  "repository": { "type": "git", "url": "git+https://github.com/zenghelin/dsh-voice-edge.git" },
  "homepage": "https://github.com/zenghelin/dsh-voice-edge#readme",
  "bugs": { "url": "https://github.com/zenghelin/dsh-voice-edge/issues" },
  "keywords": ["deepseek-harness", "dsh-plugin", "tts", "voice", "qq"]
}