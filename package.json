{
  "name": "dsh-voice-edge",
  "version": "0.0.1",
  "description": "给 DSH 里的 AI 伙伴一副嗓子：想说什么就合成成语音，直接发到 QQ（OneBot 11 / NapCat / SnowLuma）。走 Node，不需要 Python。",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "dependencies": { "msedge-tts": "^2.1.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    }
  },
  "keywords": ["deepseek-harness", "dsh-plugin", "tts", "voice", "qq"]
}